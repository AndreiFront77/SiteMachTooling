# Copie para .env.local (dev) ou configure em Vercel > Settings > Environment Variables. NUNCA versionar segredos.
RESEND_API_KEY=
MAIL_TO=destinatario-corporativo@empresa.com.br      # aceita vários, separados por vírgula
MAIL_FROM="Site Mach Tooling <contato@seu-dominio-verificado.com.br>"
ALLOWED_ORIGIN=                                      # ex.: https://www.dominio-oficial.com.br
TURNSTILE_SECRET_KEY=                                # opcional (Cloudflare Turnstile); chave pública vai em assets/js/config.js
